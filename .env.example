# harmony-sase-fix — optional org overrides (non-secret).
# Copy to ~/.config/harmony-sase-fix.env (or point $HARMONY_FIX_ENV at it).
# Everything here is optional; generic defaults apply when a value is unset.

# Access-request guide, shown for the "device/access expired" case (exit 4).
HARMONY_FIX_ACCESS_URL="https://your-wiki/vpn-access"

# Escalation contact, shown in `--help` and on failures.
HARMONY_FIX_ESCALATE="Contact your VPN / IT admin."

# Where to reinstall the app from, shown when the app payload is missing.
HARMONY_FIX_REINSTALL_SRC="your MDM / self-service portal"
